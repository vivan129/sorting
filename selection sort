def selection_sort(arr):
    comparisons = 0
    swaps = 0
    n = len(arr)

    for i in range(n):
        min_index = i
        for j in range(i + 1, n):
            comparisons += 1
            if arr[j] < arr[min_index]:
                min_index = j

        if min_index != i:
            arr[i], arr[min_index] = arr[min_index], arr[i]
            swaps += 1

    return arr, comparisons, swaps


# Take input
heights = []
print("Enter 5 heights:")
for i in range(5):
    h = int(input(f"Height {i+1}: "))
    heights.append(h)

sorted_heights, comparisons, swaps = selection_sort(heights.copy())

print("\nSelection Sort Result:")
print("Sorted heights:", sorted_heights)
print("Comparisons:", comparisons)
print("Swaps:", swaps)
